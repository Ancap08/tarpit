{
  "name": "tarpit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A small browser tower defense game.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:slow": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/slow-tests.ts",
    "test:e2e": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/test-e2e.ts",
    "test:e2e:keep-cost": "playwright test --project=phone --workers=1 --grep @keep-cost",
    "sim": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/simulate.ts",
    "sounds": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/render-sounds.ts",
    "demo": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/record-demo.ts",
    "check:assets": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-asset-manifest.ts",
    "check:size": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-size-budget.ts",
    "sim:keep": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/simulate-keep.ts"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
